# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix info.txt admin_key_list1.txt admin_key_list2.txt list1.txt list2.txt foo_info1.txt foo_info2.txt foo_info3.txt foo_info4.txt foo_info5.txt

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# add key to admin
icy user add-pubkey admin "$ADMIN2_AUTHORIZED_KEY"
icy user info admin
icy info
cmpenv stdout info.txt


# list admin pubkeys
icy pubkey list
cmpenv stdout admin_key_list1.txt

# remove key
icy pubkey remove $ADMIN2_AUTHORIZED_KEY
icy pubkey list
cmpenv stdout admin_key_list2.txt

# add key back key
icy pubkey add $ADMIN2_AUTHORIZED_KEY
icy pubkey list
cmpenv stdout admin_key_list1.txt

# list users
icy user list
cmpenv stdout list1.txt

# create a new user
icy user create foo --key "$USER1_AUTHORIZED_KEY"
icy user list
cmpenv stdout list2.txt

# get new user info
icy user info foo
cmpenv stdout foo_info1.txt

# make user admin
icy user set-admin foo true
icy user info foo
cmpenv stdout foo_info2.txt

# remove admin
icy user set-admin foo false
icy user info foo
cmpenv stdout foo_info3.txt

# remove key from user
icy user remove-pubkey foo "$USER1_AUTHORIZED_KEY"
icy user info foo
cmpenv stdout foo_info4.txt

# rename user
icy user set-username foo foo2
icy user info foo2
cmpenv stdout foo_info5.txt

# remove user
icy user delete foo2
! stdout .
icy user list
cmpenv stdout list1.txt

# stop the server
[windows] stopserver
[windows] ! stderr .


-- info.txt --
Username: admin
Admin: true
Public keys:
  $ADMIN1_AUTHORIZED_KEY
  $ADMIN2_AUTHORIZED_KEY
-- list1.txt --
admin
-- list2.txt --
admin
foo
-- foo_info1.txt --
Username: foo
Admin: false
Public keys:
  $USER1_AUTHORIZED_KEY
-- foo_info2.txt --
Username: foo
Admin: true
Public keys:
  $USER1_AUTHORIZED_KEY
-- foo_info3.txt --
Username: foo
Admin: false
Public keys:
  $USER1_AUTHORIZED_KEY
-- foo_info4.txt --
Username: foo
Admin: false
Public keys:
-- foo_info5.txt --
Username: foo2
Admin: false
Public keys:
-- admin_key_list1.txt --
$ADMIN1_AUTHORIZED_KEY
$ADMIN2_AUTHORIZED_KEY
-- admin_key_list2.txt --
$ADMIN1_AUTHORIZED_KEY
