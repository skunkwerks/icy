# vi: set ft=conf

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# check default allow-keyless
icy settings allow-keyless true
icy settings allow-keyless
stdout 'true.*'

# change allow-keyless and check
icy settings allow-keyless false
icy settings allow-keyless
stdout 'false.*'

# check default anon-access
icy settings anon-access
stdout 'read-only.*'

# change anon-access to all available options, and check them
icy settings anon-access no-access
icy settings anon-access
stdout 'no-access.*'

icy settings anon-access read-only
icy settings anon-access
stdout 'read-only.*'

icy settings anon-access read-write
icy settings anon-access
stdout 'read-write.*'

icy settings anon-access admin-access
icy settings anon-access
stdout 'admin-access.*'

# try to set a bad access
! icy settings anon-access nope
! stdout .
stderr .

# stop the server
[windows] stopserver

