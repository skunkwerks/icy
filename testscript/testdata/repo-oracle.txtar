# vi: set ft=conf

# A caller who cannot read a repository must get the same answer whether the
# repository is private or does not exist, so names cannot be guessed.

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# a private repo with a branch and a tag
icy repo create secret -p
git clone ssh://localhost:$SSH_PORT/secret secret
mkfile ./secret/README.md '# secret'
git -C secret add -A
git -C secret commit -m 'first'
git -C secret tag v1
git -C secret push origin HEAD --tags

# anonymous key: user1 is not registered yet, so uicy is anonymous
! uicy repo info secret
stderr 'unauthorized'
! stdout .
cp stderr want.txt
! uicy repo info ghost
cmp stderr want.txt
! stdout .
! uicy repo tree secret
cmp stderr want.txt
! stdout .
! uicy repo tree ghost
cmp stderr want.txt
! stdout .
! uicy repo blob secret README.md
cmp stderr want.txt
! stdout .
! uicy repo blob ghost README.md
cmp stderr want.txt
! stdout .
! uicy repo branch list secret
cmp stderr want.txt
! stdout .
! uicy repo branch list ghost
cmp stderr want.txt
! stdout .
! uicy repo branch default secret
cmp stderr want.txt
! stdout .
! uicy repo branch default ghost
cmp stderr want.txt
! stdout .
! uicy repo branch default secret master
cmp stderr want.txt
! stdout .
! uicy repo branch default ghost master
cmp stderr want.txt
! stdout .
! uicy repo branch delete secret master
cmp stderr want.txt
! stdout .
! uicy repo branch delete ghost master
cmp stderr want.txt
! stdout .
! uicy repo tag list secret
cmp stderr want.txt
! stdout .
! uicy repo tag list ghost
cmp stderr want.txt
! stdout .
! uicy repo tag delete secret v1
cmp stderr want.txt
! stdout .
! uicy repo tag delete ghost v1
cmp stderr want.txt
! stdout .
! uicy repo delete secret
cmp stderr want.txt
! stdout .
! uicy repo delete ghost
cmp stderr want.txt
! stdout .
! uicy repo rename secret other
cmp stderr want.txt
! stdout .
! uicy repo rename ghost other
cmp stderr want.txt
! stdout .
! uicy repo collab list secret
cmp stderr want.txt
! stdout .
! uicy repo collab list ghost
cmp stderr want.txt
! stdout .
! uicy repo collab add secret admin
cmp stderr want.txt
! stdout .
! uicy repo collab add ghost admin
cmp stderr want.txt
! stdout .
! uicy repo collab add secret admin admin-access
cmp stderr want.txt
! stdout .
! uicy repo collab add ghost admin admin-access
cmp stderr want.txt
! stdout .
! uicy repo collab remove secret admin
cmp stderr want.txt
! stdout .
! uicy repo collab remove ghost admin
cmp stderr want.txt
! stdout .
! uicy repo description secret
cmp stderr want.txt
! stdout .
! uicy repo description ghost
cmp stderr want.txt
! stdout .
! uicy repo description secret new
cmp stderr want.txt
! stdout .
! uicy repo description ghost new
cmp stderr want.txt
! stdout .
! uicy repo project-name secret
cmp stderr want.txt
! stdout .
! uicy repo project-name ghost
cmp stderr want.txt
! stdout .
! uicy repo project-name secret new
cmp stderr want.txt
! stdout .
! uicy repo project-name ghost new
cmp stderr want.txt
! stdout .
! uicy repo private secret
cmp stderr want.txt
! stdout .
! uicy repo private ghost
cmp stderr want.txt
! stdout .
! uicy repo private secret true
cmp stderr want.txt
! stdout .
! uicy repo private ghost true
cmp stderr want.txt
! stdout .
! uicy repo hidden secret
cmp stderr want.txt
! stdout .
! uicy repo hidden ghost
cmp stderr want.txt
! stdout .
! uicy repo hidden secret true
cmp stderr want.txt
! stdout .
! uicy repo hidden ghost true
cmp stderr want.txt
! stdout .
! uicy repo mirror secret
cmp stderr want.txt
! stdout .
! uicy repo mirror ghost
cmp stderr want.txt
! stdout .
! uicy repo mirror secret true
cmp stderr want.txt
! stdout .
! uicy repo mirror ghost true
cmp stderr want.txt
! stdout .
! uicy repo webhook list secret
cmp stderr want.txt
! stdout .
! uicy repo webhook list ghost
cmp stderr want.txt
! stdout .

# registered user without access
icy user create user1 --key "$USER1_AUTHORIZED_KEY"
! uicy repo info secret
stderr 'repository not found'
! stdout .
cp stderr want.txt
! uicy repo info ghost
cmp stderr want.txt
! stdout .
! uicy repo tree secret
cmp stderr want.txt
! stdout .
! uicy repo tree ghost
cmp stderr want.txt
! stdout .
! uicy repo blob secret README.md
cmp stderr want.txt
! stdout .
! uicy repo blob ghost README.md
cmp stderr want.txt
! stdout .
! uicy repo branch list secret
cmp stderr want.txt
! stdout .
! uicy repo branch list ghost
cmp stderr want.txt
! stdout .
! uicy repo branch default secret
cmp stderr want.txt
! stdout .
! uicy repo branch default ghost
cmp stderr want.txt
! stdout .
! uicy repo branch default secret master
cmp stderr want.txt
! stdout .
! uicy repo branch default ghost master
cmp stderr want.txt
! stdout .
! uicy repo branch delete secret master
cmp stderr want.txt
! stdout .
! uicy repo branch delete ghost master
cmp stderr want.txt
! stdout .
! uicy repo tag list secret
cmp stderr want.txt
! stdout .
! uicy repo tag list ghost
cmp stderr want.txt
! stdout .
! uicy repo tag delete secret v1
cmp stderr want.txt
! stdout .
! uicy repo tag delete ghost v1
cmp stderr want.txt
! stdout .
! uicy repo delete secret
cmp stderr want.txt
! stdout .
! uicy repo delete ghost
cmp stderr want.txt
! stdout .
! uicy repo rename secret other
cmp stderr want.txt
! stdout .
! uicy repo rename ghost other
cmp stderr want.txt
! stdout .
! uicy repo collab list secret
cmp stderr want.txt
! stdout .
! uicy repo collab list ghost
cmp stderr want.txt
! stdout .
! uicy repo collab add secret admin
cmp stderr want.txt
! stdout .
! uicy repo collab add ghost admin
cmp stderr want.txt
! stdout .
! uicy repo collab add secret admin admin-access
cmp stderr want.txt
! stdout .
! uicy repo collab add ghost admin admin-access
cmp stderr want.txt
! stdout .
! uicy repo collab remove secret admin
cmp stderr want.txt
! stdout .
! uicy repo collab remove ghost admin
cmp stderr want.txt
! stdout .
! uicy repo description secret
cmp stderr want.txt
! stdout .
! uicy repo description ghost
cmp stderr want.txt
! stdout .
! uicy repo description secret new
cmp stderr want.txt
! stdout .
! uicy repo description ghost new
cmp stderr want.txt
! stdout .
! uicy repo project-name secret
cmp stderr want.txt
! stdout .
! uicy repo project-name ghost
cmp stderr want.txt
! stdout .
! uicy repo project-name secret new
cmp stderr want.txt
! stdout .
! uicy repo project-name ghost new
cmp stderr want.txt
! stdout .
! uicy repo private secret
cmp stderr want.txt
! stdout .
! uicy repo private ghost
cmp stderr want.txt
! stdout .
! uicy repo private secret true
cmp stderr want.txt
! stdout .
! uicy repo private ghost true
cmp stderr want.txt
! stdout .
! uicy repo hidden secret
cmp stderr want.txt
! stdout .
! uicy repo hidden ghost
cmp stderr want.txt
! stdout .
! uicy repo hidden secret true
cmp stderr want.txt
! stdout .
! uicy repo hidden ghost true
cmp stderr want.txt
! stdout .
! uicy repo mirror secret
cmp stderr want.txt
! stdout .
! uicy repo mirror ghost
cmp stderr want.txt
! stdout .
! uicy repo mirror secret true
cmp stderr want.txt
! stdout .
! uicy repo mirror ghost true
cmp stderr want.txt
! stdout .
! uicy repo webhook list secret
cmp stderr want.txt
! stdout .
! uicy repo webhook list ghost
cmp stderr want.txt
! stdout .

# nothing leaked through a write that silently succeeded
icy repo hidden secret
stdout 'false'
icy repo project-name secret
! stdout 'new'
icy repo description secret
! stdout 'new'
icy repo list
stdout 'secret'
! stdout 'other'
! stdout 'ghost'

# a directory with no database row answers like any unreadable repository
mkdir $DATA_PATH/repos/orphan.git
! uicy repo info orphan
cmp stderr want.txt
! stdout .
! uicy repo delete orphan
cmp stderr want.txt
! stdout .

# a server admin can still delete a database row whose directory is gone
icy repo create gone
rm $DATA_PATH/repos/gone.git
icy repo list
stdout 'gone'
icy repo delete gone
icy repo list
! stdout 'gone'
! icy repo delete gone
stderr 'repository not found'

# a reader who cannot write is still told so, since existence is no secret
icy repo collab add secret user1 read-only
uicy repo description secret
! uicy repo delete secret
stderr 'unauthorized'
! uicy repo description secret new
stderr 'unauthorized'
! uicy repo collab list secret
stderr 'unauthorized'

# stop the server; the last command must succeed so stderr is clean
icy repo list
[windows] stopserver
[windows] ! stderr .
