# vi: set ft=conf

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

icy user create foo --key "$USER1_AUTHORIZED_KEY"
usoft repo create foo-repo

# a user who owns repositories cannot be removed until they are gone
! icy user delete foo
stderr '.*still owns repositories.*foo-repo.*'
icy repo list
stdout 'foo-repo'

icy repo delete foo-repo
icy user delete foo
! icy user info foo
stderr '.*not found.*'
# a placeholder to reset stderr
icy help

# stop the server
[windows] stopserver
[windows] ! stderr .
