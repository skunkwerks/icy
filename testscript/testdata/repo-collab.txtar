# vi: set ft=conf

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# setup
icy repo import test https://github.com/charmbracelet/wizard-tutorial.git
icy user create foo --key "$USER1_AUTHORIZED_KEY"

# list collabs
icy repo collab list test
! stdout .

# add collab
icy repo collab add test foo
icy repo collab list test
stdout 'foo'

# remove collab
icy repo collab remove test foo
icy repo collab list test
! stdout .

# create empty repo
icy repo create empty '-d "empty repo"'

# add collab
icy repo collab add empty foo
# add collab again
# test issue #464 https://github.com/charmbracelet/soft-serve/issues/464
! icy repo collab add empty foo
stderr '.*already exists.*'
# a placeholder to reset stderr
icy help

# a no-access collaborator cannot read a private repo (GHSA-pmgj-8mr6-9rff)
icy repo create secret -p
! usoft repo description secret
stderr '.*repository not found.*'
icy repo collab add secret foo no-access
! usoft repo description secret
stderr '.*repository not found.*'
icy repo collab remove secret foo
icy repo collab add secret foo read-only
usoft repo description secret

# stop the server
[windows] stopserver
[windows] ! stderr .
