# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix repo3.txt

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# import private
icy repo import --private repo1 https://github.com/charmbracelet/wizard-tutorial.git
icy repo private repo1
stdout 'true'

# import hidden
icy repo import --hidden repo2 https://github.com/charmbracelet/wizard-tutorial.git
icy repo hidden repo2
stdout 'true'

# import with name and description
icy repo import --name 'repo33' --description 'descriptive' repo3 https://github.com/charmbracelet/wizard-tutorial.git
icy repo info repo3
cmp stdout repo3.txt

# stop the server
[windows] stopserver
[windows] ! stderr .

-- repo3.txt --
Project Name: repo33
Repository: repo3
Description: descriptive
Private: false
Hidden: false
Visibility: public
Mirror: false
Owner: admin
Default Branch: main
Branches:
  - main
