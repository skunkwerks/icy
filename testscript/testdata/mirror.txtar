# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix info1.txt info2.txt tree.txt

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# import a repo
icy repo import --mirror charmbracelet/wizard-tutorial https://github.com/charmbracelet/wizard-tutorial.git

# check empty description file
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/description ''

# check repo info
icy repo info charmbracelet/wizard-tutorial
cmp stdout info1.txt

# check repo list
icy repo list
stdout charmbracelet/wizard-tutorial

# create a non-mirror repo
icy repo create test-normal
icy repo mirror test-normal
stdout false
# try to enable mirror on repo without remote - should fail
! icy repo mirror test-normal true

# disable mirror
icy repo mirror charmbracelet/wizard-tutorial false
icy repo mirror charmbracelet/wizard-tutorial
stdout false
# verify git config no longer has mirror
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/config
! stdout 'mirror = true'

# re-enable mirror
icy repo mirror charmbracelet/wizard-tutorial true
icy repo mirror charmbracelet/wizard-tutorial
stdout true
# verify git config has mirror again
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/config
stdout 'mirror = true'

# set project name
icy repo project-name charmbracelet/wizard-tutorial wizard-tutorial
icy repo list
stdout wizard-tutorial


# check description
icy repo description charmbracelet/wizard-tutorial
! stdout .

# set description
icy repo description charmbracelet/wizard-tutorial "testing repo"
icy repo description charmbracelet/wizard-tutorial
stdout 'testing repo'
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/description 'testing repo'

# rename
icy repo rename charmbracelet/wizard-tutorial charmbracelet/test
icy repo list
stdout charmbracelet/test # TODO: shouldn't this still show the project-name?

# check its not private
icy repo private charmbracelet/test
stdout false
exists $DATA_PATH/repos/charmbracelet/test.git/git-daemon-export-ok

# make it private
icy repo private charmbracelet/test  true
icy repo private charmbracelet/test
stdout true
! exists $DATA_PATH/repos/charmbracelet/test.git/git-daemon-export-ok

# check its not hidden
icy repo hidden charmbracelet/test
stdout false

# make it hidden
icy repo hidden charmbracelet/test  true
icy repo hidden charmbracelet/test
stdout true

# print tree
icy repo tree charmbracelet/test
cmp stdout tree.txt

# check repo info again
icy repo info charmbracelet/test
cmp stdout info2.txt

# get a file
icy repo blob charmbracelet/test README.md
stdout '.*Wizard.*'

# stop the server
[windows] stopserver
[windows] ! stderr .


-- info1.txt --
Project Name:
Repository: charmbracelet/wizard-tutorial
Description:
Private: false
Hidden: false
Mirror: true
Owner: admin
Default Branch: main
Branches:
  - main
-- info2.txt --
Project Name: wizard-tutorial
Repository: charmbracelet/test
Description: testing repo
Private: true
Hidden: true
Mirror: true
Owner: admin
Default Branch: main
Branches:
  - main
-- tree.txt --
-rw-r--r--	10 B	 .gitignore
-rw-r--r--	1.3 kB	 README.md
-rw-r--r--	970 B	 go.mod
-rw-r--r--	5.3 kB	 go.sum
-rw-r--r--	2.2 kB	 input.go
-rw-r--r--	2.9 kB	 main.go
