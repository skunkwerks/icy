# vi: set ft=conf

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create user
icy user create user1 --key "$USER1_AUTHORIZED_KEY"

# generate jwt token
uicy token create 'test1'
stdout 'ss_.*'
stderr 'Access token created'
uicy token create --expires-in 1y 'test2'
stdout 'ss_.*'
stderr 'Access token created'
uicy token create --expires-in 1ns 'test3'
stdout 'ss_.*'
stderr 'Access token created'

# list tokens
uicy token list
cp stdout tokens.txt
grep '1.*test1.*-' tokens.txt
grep '2.*test2.*1 year from now' tokens.txt
grep '3.*est3.*expired' tokens.txt

# delete token
uicy token delete 1
stderr 'Access token deleted'
! uicy token delete 1
stderr 'token not found'

# stop the server
[windows] stopserver
