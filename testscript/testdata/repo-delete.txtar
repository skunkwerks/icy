# vi: set ft=conf

# start icy serve
exec icy serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

icy repo create repo1
icy repo create repo-to-delete
icy repo delete repo-to-delete
! icy repo delete nope
stderr '.*not found.*'

# missing argument should fail
! icy repo branch delete repo1
stderr 'Error.*accepts 2 arg.*'

icy repo list
stdout 'repo1'

# stop the server
[windows] stopserver
[windows] ! stderr .
